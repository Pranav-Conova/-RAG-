# Copy to .env and fill in. Never commit .env.

# --- NVIDIA API catalog (build.nvidia.com) -> "Get API Key" (starts with nvapi-) ---
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Free tier is rate limited (~40 req/min, varies by model). Stay a bit under it.
NIM_REQUESTS_PER_MINUTE=35

# --- LLMs (OpenAI-compatible chat endpoint) ---
# Main model: answer generation. Fast model: query understanding, extraction, verification.
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
LLM_FAST_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Set true to also send NIM guided decoding (nvext.guided_json); not every hosted model supports it.
LLM_GUIDED_JSON=false

# --- Embeddings ---
EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
# Must match the DB schema. 1024 keeps storage small enough for free Postgres tiers.
EMBED_DIM=1024
# Send the `dimensions` param (Matryoshka truncation). Set false for fixed-size models.
EMBED_SEND_DIMENSIONS=true

# --- Reranker ---
# openrouter = hosted cross-encoder via OpenRouter, falls back to llm on errors/limits (recommended)
# llm        = the fast LLM scores passages (no extra key needed)
# nim        = NVIDIA-hosted cross-encoder (not currently served to free keys)
# none       = keep retrieval order
RERANK_BACKEND=openrouter
# openrouter.ai -> Keys. Free models: 20 req/min, 50 req/day (1000/day after a one-time $10 top-up).
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b:free
# Only used when RERANK_BACKEND=nim:
RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b
RERANK_URL=

# --- Database ---
# Local (docker compose):
DATABASE_URL=postgresql://asof:asof@localhost:5432/asof
# Neon: Dashboard -> Connect -> pooled connection string (region: AWS ap-southeast-1 / Singapore).
# DATABASE_URL=postgresql://<user>:<password>@ep-<name>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
