version: 0.1.0
repository-code: "https://github.com/Pranav-Conova/-RAG-"
url: "https://github.com/Pranav-Conova/-RAG-"
keywords:
  - retrieval-augmented generation
  - time-aware RAG
  - temporal retrieval
  - legal AI
  - Indian GST
  - regulatory compliance
  - pgvector
  - hybrid search
